# Sarvam AI subscription key for chat and speech features
SARVAM_API_KEY=your-sarvam-api-key
# Telegram bot token from BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Telegram chat ID used for human desk notifications
DESK_CHAT_ID=your-desk-chat-id
# Local Paytm core simulator URL
CORE_URL=http://localhost:8001
# Local Mitra platform URL
PLATFORM_URL=http://localhost:8000
# Publicly reachable core URL embedded in payment links
PUBLIC_CORE_URL=http://localhost:8001
# Shared secret used to authenticate core webhooks
CORE_SECRET=devsecret
